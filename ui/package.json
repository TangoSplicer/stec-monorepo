{
  "name": "crimegraph",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "prepare:web-sqlite": "node scripts/copy-sql-wasm.mjs",
    "dev": "npm run prepare:web-sqlite && vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "npm run prepare:web-sqlite && npm run typecheck && vite build",
    "audit:production": "npm audit --omit=dev",
    "generate-assets": "capacitor-assets generate",
    "sync": "cap sync"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^9.1.2",
    "@capacitor-community/sqlite": "^7.0.3",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/camera": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "cordova-plugin-bluetoothle": "^6.7.4",
    "cytoscape": "^3.28.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^7.18.2",
    "sql.js": "^1.14.1",
    "vis-timeline": "^7.7.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.0",
    "fake-indexeddb": "^6.2.2",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.2.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}