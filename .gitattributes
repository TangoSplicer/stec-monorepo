# Keep Windows Gradle wrappers in the line ending expected by cmd.exe.
*.bat text eol=crlf

# Normalize repository text files to LF on checkout where platform-specific endings are not required.
*.sh text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
